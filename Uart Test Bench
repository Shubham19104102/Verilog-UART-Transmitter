`timescale 1ns/1ps

module uart_tx_tb;

    reg clk;
    reg rst;
    reg tx_start;
    reg [7:0] data_in;

    wire tx;
    wire busy;

    uart_tx #(
        .CLK_FREQ(50_000_000),
        .BAUD_RATE(115200)
    ) DUT (
        .clk(clk),
        .rst(rst),
        .tx_start(tx_start),
        .data_in(data_in),
        .tx(tx),
        .busy(busy)
    );

    always #10 clk = ~clk;

    initial begin

        clk = 0;
        rst = 1;
        tx_start = 0;
        data_in = 8'b0;

        #100;
        rst = 0;

        #100;
        data_in = 8'b10101010;
        tx_start = 1;

        #20;
        tx_start = 0;

        wait(!busy);

        #100;

        data_in = 8'b11001100;
        tx_start = 1;

        #20;
        tx_start = 0;

        wait(!busy);

        #100;
        $finish;

    end

endmodule
