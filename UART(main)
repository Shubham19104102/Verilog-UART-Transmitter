module uart_tx #(
    parameter CLK_FREQ = 50_000_000,
    parameter BAUD_RATE = 115200
)(
    input  wire       clk,
    input  wire       rst,
    input  wire       tx_start,
    input  wire [7:0] data_in,

    output reg        tx,
    output reg        busy
);

    localparam BAUD_COUNT = CLK_FREQ / BAUD_RATE;

    localparam IDLE  = 2'b00;
    localparam START = 2'b01;
    localparam DATA  = 2'b10;
    localparam STOP  = 2'b11;

    reg [1:0] state;
    reg [15:0] baud_cnt;
    reg [2:0] bit_cnt;
    reg [7:0] data_reg;

    always @(posedge clk or posedge rst) begin

        if (rst) begin
            state    <= IDLE;
            baud_cnt <= 0;
            bit_cnt  <= 0;
            data_reg <= 0;
            tx       <= 1'b1;
            busy     <= 1'b0;
        end

        else begin

            case (state)

                IDLE: begin
                    tx       <= 1'b1;
                    busy     <= 1'b0;
                    baud_cnt <= 0;
                    bit_cnt  <= 0;

                    if (tx_start) begin
                        data_reg <= data_in;
                        busy     <= 1'b1;
                        state    <= START;
                    end
                end

                START: begin
                    tx <= 1'b0;

                    if (baud_cnt == BAUD_COUNT-1) begin
                        baud_cnt <= 0;
                        state    <= DATA;
                    end
                    else
                        baud_cnt <= baud_cnt + 1;
                end

                DATA: begin
                    tx <= data_reg[bit_cnt];

                    if (baud_cnt == BAUD_COUNT-1) begin
                        baud_cnt <= 0;

                        if (bit_cnt == 3'd7) begin
                            bit_cnt <= 0;
                            state   <= STOP;
                        end
                        else
                            bit_cnt <= bit_cnt + 1;
                    end
                    else
                        baud_cnt <= baud_cnt + 1;
                end

                STOP: begin
                    tx <= 1'b1;

                    if (baud_cnt == BAUD_COUNT-1) begin
                        baud_cnt <= 0;
                        busy     <= 1'b0;
                        state    <= IDLE;
                    end
                    else
                        baud_cnt <= baud_cnt + 1;
                end

                default:
                    state <= IDLE;

            endcase
        end
    end

endmodule
